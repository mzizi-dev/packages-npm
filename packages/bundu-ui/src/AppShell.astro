---
/**
 * AppShell — the app-layout shell for Astro apps (Mzizi `mzizi-sidebar` +
 * `mzizi-header` pattern), server-rendered with one small script:
 *
 * - lg and up: a fixed sidebar — brand, sectioned navigation with the
 *   brand-primary active state, a light/dark switch in the footer — beside
 *   the page.
 * - below lg: a sticky top bar with a menu button; the same sidebar slides
 *   in over a scrim. Closed, it is `inert` (out of the tab order and the
 *   accessibility tree); Escape or the scrim close it and focus returns.
 * - a skip link, and the seven-mineral strip on the left edge.
 *
 * Put it inside <body>. The theme switch writes `data-theme` on <html> and
 * localStorage `bundu-theme` (override with `themeKey`).
 */
import Icon from "./Icon.astro";
import MineralStrip from "./MineralStrip.astro";

type IconName = "home" | "image" | "mail" | "grid" | "layers" | "search" | "history" | "code" | "terminal";

interface NavItem {
  name: string;
  href: string;
  icon?: IconName;
}
interface NavSection {
  label?: string;
  items: NavItem[];
}
interface Props {
  appName: string;
  /** Small line under the app name. */
  tagline?: string;
  sections: NavSection[];
  /** Footer note, e.g. a version. */
  footnote?: string;
  /** localStorage key for the theme choice. */
  themeKey?: string;
}

const { appName, tagline, sections, footnote, themeKey = "bundu-theme" } = Astro.props;
const path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "").replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---

<a href="#main" class="btn-primary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]">Skip to content</a>
<MineralStrip />

<header
  data-slot="app-shell-topbar"
  class="sticky top-0 z-30 flex h-16 items-center justify-between gap-3 border-b border-border bg-background/90 pl-5 pr-3 backdrop-blur lg:hidden"
>
  <a href="/" class="flex min-h-12 items-center gap-2" aria-label={`${appName} — home`}>
    <slot name="brand"><span class="font-serif text-xl font-bold tracking-tight text-primary">{appName}</span></slot>
  </a>
  <button type="button" data-shell-open class="btn-ghost h-12 w-12 px-0 text-xl" aria-controls="app-shell-sidebar" aria-expanded="false">
    <Icon name="menu" title="Open navigation" />
  </button>
</header>

<div data-shell-scrim class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" aria-hidden="true"></div>

<aside
  id="app-shell-sidebar"
  data-slot="app-shell-sidebar"
  class="fixed inset-y-0 left-1.5 z-50 flex w-72 max-w-[85vw] -translate-x-[110%] flex-col border-r border-border bg-card transition-transform duration-300 ease-soft data-[open=true]:translate-x-0 lg:z-20 lg:w-64 lg:translate-x-0"
  aria-label="Main"
>
  <div class="flex h-16 items-center justify-between gap-2 px-5">
    <a href="/" class="flex min-h-12 flex-col justify-center leading-none" aria-label={`${appName} — home`}>
      <slot name="brand"><span class="font-serif text-lg font-bold tracking-tight text-primary">{appName}</span></slot>
      {tagline && <span class="text-caption font-medium text-foreground/80">{tagline}</span>}
    </a>
    <button type="button" data-shell-close class="btn-ghost h-12 w-12 px-0 text-xl lg:hidden"><Icon name="close" title="Close navigation" /></button>
  </div>
  <nav class="flex-1 overflow-y-auto px-3 py-2" aria-label="Main">
    {
      sections.map((s) => (
        <div class="mb-5">
          {s.label && <p class="px-3 pb-1 text-caption font-semibold uppercase tracking-[0.12em] text-foreground/80">{s.label}</p>}
          <ul class="space-y-1">
            {s.items.map((it) => {
              const on = isActive(it.href);
              return (
                <li>
                  <a
                    href={it.href}
                    aria-current={on ? "page" : undefined}
                    class={[
                      "flex min-h-12 items-center gap-3 rounded-full px-4 text-body-sm font-medium transition-colors duration-200 ease-soft",
                      on ? "bg-primary/15 text-foreground" : "text-foreground/80 hover:bg-muted hover:text-foreground",
                    ].join(" ")}
                  >
                    {it.icon && (
                      <span class={on ? "text-lg text-primary" : "text-lg"}>
                        <Icon name={it.icon} />
                      </span>
                    )}
                    {it.name}
                    {on && <span class="ml-auto h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
  <div class="flex items-center justify-between gap-2 border-t border-border px-5 py-3">
    <button type="button" data-shell-theme class="btn-ghost h-12 gap-2 px-3 text-body-sm">
      <Icon name="sun" /><span>Switch theme</span>
    </button>
    {footnote && <span class="font-mono text-caption text-foreground/80">{footnote}</span>}
  </div>
</aside>

<main id="main" data-slot="app-shell-main" class="min-w-0 lg:pl-[17.5rem]">
  <slot />
</main>

<script is:inline define:vars={{ themeKey }}>
  (function () {
    var root = document.documentElement;
    var side = document.getElementById("app-shell-sidebar");
    var scrim = document.querySelector("[data-shell-scrim]");
    var openBtn = document.querySelector("[data-shell-open]");
    var wide = matchMedia("(min-width: 1024px)");
    function sync() {
      side.inert = !wide.matches && side.getAttribute("data-open") !== "true";
    }
    function setOpen(open) {
      side.setAttribute("data-open", String(open));
      scrim.classList.toggle("hidden", !open);
      openBtn.setAttribute("aria-expanded", String(open));
      sync();
      if (open) side.querySelector("a, button").focus();
      else openBtn.focus();
    }
    wide.addEventListener("change", sync);
    sync();
    openBtn.addEventListener("click", function () { setOpen(true); });
    document.querySelector("[data-shell-close]").addEventListener("click", function () { setOpen(false); });
    scrim.addEventListener("click", function () { setOpen(false); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && side.getAttribute("data-open") === "true") setOpen(false);
    });
    document.querySelector("[data-shell-theme]").addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(themeKey, next); } catch (_) {}
    });
  })();
</script>
