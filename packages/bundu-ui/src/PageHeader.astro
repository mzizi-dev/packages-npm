---
/**
 * PageHeader — the app-page header (Mzizi `page-header`): eyebrow, serif
 * title, lead, and an `actions` slot that sits right on wide screens and
 * wraps under the text on narrow ones. For marketing sections, use
 * SectionHeader.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Heading level; the visual size stays text-h2. */
  as?: "h1" | "h2";
  class?: string;
}

const { eyebrow, title, description, as: Tag = "h1", class: className } = Astro.props;
---

<header
  data-slot="page-header"
  class={["flex flex-col gap-4 md:flex-row md:items-end md:justify-between", className].filter(Boolean).join(" ")}
>
  <div class="min-w-0 max-w-3xl">
    {eyebrow && <p class="text-caption font-semibold uppercase tracking-[0.12em] text-primary">{eyebrow}</p>}
    <Tag class="mt-1 font-serif text-h2 text-foreground text-balance">{title}</Tag>
    {description && <p class="mt-2 text-body text-foreground/80 text-pretty">{description}</p>}
  </div>
  <div class="flex shrink-0 flex-wrap gap-2 whitespace-nowrap"><slot name="actions" /></div>
</header>
