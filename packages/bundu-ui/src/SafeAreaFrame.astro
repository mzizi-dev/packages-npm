---
/**
 * SafeAreaFrame — a canvas shape at thumbnail size: its true aspect ratio,
 * with the bands a platform covers with its own interface shaded (a story's
 * top and reply bars, a reel's action rail). The Astro port of the registry's
 * `safe-area-frame`; geometry from `safe-area.ts`. Decorative — put the size's
 * name and dimensions in text beside it.
 */
import { safeAreaBands, type SafeInsets } from "./safe-area";

interface Props {
  width: number;
  height: number;
  safe?: SafeInsets;
  /** The square it fits in, in CSS pixels. */
  box?: number;
  class?: string;
}

const { width, height, safe = [0, 0, 0, 0], box = 56, class: className } = Astro.props;
const b = safeAreaBands(width, height, safe, box);
---

<span
  data-slot="safe-area-frame"
  aria-hidden="true"
  class={["grid shrink-0 place-items-center", className].filter(Boolean).join(" ")}
  style={`width:${box}px;height:${box}px`}
>
  <span
    data-slot="safe-area-frame-canvas"
    class="relative block overflow-hidden rounded-[4px] border border-foreground/40 bg-muted"
    style={`width:${b.width}px;height:${b.height}px`}
  >
    {b.top > 0 && <span data-band="top" class="absolute inset-x-0 top-0 bg-primary/30" style={`height:${b.top}%`} />}
    {b.bottom > 0 && <span data-band="bottom" class="absolute inset-x-0 bottom-0 bg-primary/30" style={`height:${b.bottom}%`} />}
    {b.left > 0 && <span data-band="left" class="absolute inset-y-0 left-0 bg-primary/20" style={`width:${b.left}%`} />}
    {b.right > 0 && <span data-band="right" class="absolute inset-y-0 right-0 bg-primary/20" style={`width:${b.right}%`} />}
  </span>
</span>
