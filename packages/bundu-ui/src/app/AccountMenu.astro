---
/**
 * AccountMenu — who is signed in, the app's own account actions (default
 * slot: an appearance form, links), and sign-out. A <details> disclosure,
 * so it opens with keyboard and screen reader and needs no script.
 * Sign-out is a POST form, not a link, so no other page can trigger it.
 */
import Button from "./Button.astro";

interface Props {
  name?: string | null;
  email?: string | null;
  /** Where the sign-out form posts. Omit to leave sign-out to the slot. */
  signOutAction?: string;
  signOutLabel?: string;
}
const { name = null, email = null, signOutAction, signOutLabel = "Sign out" } = Astro.props;
const shown = name ?? email ?? "Your account";
const initials =
  (name ?? email ?? "?")
    .split(/[\s@.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join("") || "?";
---

<details class="group relative" data-slot="account-menu">
  <summary class="flex min-h-12 cursor-pointer list-none items-center gap-3 rounded-full py-1 pr-3 pl-1 hover:bg-muted [&::-webkit-details-marker]:hidden">
    <span aria-hidden="true" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-muted text-body-sm font-semibold">{initials}</span>
    <span class="hidden max-w-48 truncate text-body-sm font-medium sm:inline">{shown}</span>
    <span class="sr-only sm:hidden">Account menu for {shown}</span>
  </summary>
  <div class="absolute right-0 z-40 mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-lg border border-border bg-card p-2 shadow-lg">
    <div class="px-4 py-3">
      <p class="truncate text-body font-medium">{name ?? "Signed in"}</p>
      {email && <p class="truncate text-body-sm text-muted-foreground">{email}</p>}
    </div>
    {Astro.slots.has("default") && <div class="border-t border-border px-4 py-3"><slot /></div>}
    {
      signOutAction && (
        <form method="post" action={signOutAction} class="border-t border-border px-4 py-3">
          <Button type="submit" variant="secondary" size="sm" fullWidth>
            {signOutLabel}
          </Button>
        </form>
      )
    }
  </div>
</details>
