---
/**
 * AppShell — the signed-in frame of an app or console: a sticky top bar
 * (brand slot, account slot), the navigation as a sidebar from lg up and
 * a disclosure below it, the page in a wide main column, and a footer.
 * Renders the body content only; the document (<html>, <head>) and the
 * skip link target are the app's. The main element has id="main".
 *
 * Slots: `brand`, `account`, `nav`, default (the page), `footer`. The
 * `nav` slot is rendered once and placed twice (sidebar from lg up, a
 * disclosure below it; only one is ever visible), so do not give elements
 * inside it an id.
 */
interface Props {
  /** Label of the narrow-screen navigation disclosure. */
  navLabel?: string;
}
const { navLabel = "Sections" } = Astro.props;
const hasNav = Astro.slots.has("nav");
const navMarkup = hasNav ? await Astro.slots.render("nav") : "";
---

<div class="flex min-h-dvh flex-col" data-slot="app-shell">
  <header class="sticky top-0 z-30 border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
    <div class="mx-auto flex h-16 max-w-[96rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <slot name="brand" />
      <slot name="account" />
    </div>
  </header>

  {
    hasNav && (
      <details class="border-b border-border lg:hidden" data-slot="mobile-nav">
        <summary class="flex min-h-12 cursor-pointer items-center px-4 text-body font-medium sm:px-6">{navLabel}</summary>
        <div class="px-4 pb-4 sm:px-6" set:html={navMarkup} />
      </details>
    )
  }

  <div class="mx-auto flex w-full max-w-[96rem] flex-1 gap-8 px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    {
      hasNav && (
        <aside class="hidden w-72 shrink-0 lg:block">
          <div class="sticky top-24" set:html={navMarkup} />
        </aside>
      )
    }
    <main id="main" tabindex="-1" class="min-w-0 flex-1 focus:outline-none">
      <div class="grid gap-8">
        <slot />
      </div>
    </main>
  </div>

  {
    Astro.slots.has("footer") && (
      <footer class="border-t border-border">
        <div class="mx-auto max-w-[96rem] px-4 py-6 text-body-sm text-muted-foreground sm:px-6 lg:px-8">
          <slot name="footer" />
        </div>
      </footer>
    )
  }
</div>
