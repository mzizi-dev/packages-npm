---
/**
 * FormLayout — a titled form card that uses the width it is given: fields
 * flow in two columns from md up and one below, actions sit at the foot.
 * Posts to the page itself (Post/Redirect/Get); Astro refuses cross-site
 * posts. A form-level error is announced as an alert.
 */
import Alert from "./Alert.astro";
import Card from "./Card.astro";

interface Props {
  title: string;
  description?: string;
  error?: string | null;
  action?: string;
  id?: string;
}
const { title, description, error, action, id = "form" } = Astro.props;
---

<section aria-labelledby={`${id}-title`} class="@container" data-slot="form-layout">
  <Card padding="none" class="overflow-hidden">
    <div class="flex flex-col gap-1 border-b border-border px-6 py-5">
      <h2 id={`${id}-title`} class="text-h4 font-semibold">{title}</h2>
      {description && <p class="text-body-sm text-muted-foreground">{description}</p>}
    </div>
    <form method="post" action={action} class="grid gap-6 px-6 py-6" novalidate>
      {
        error && (
          <Alert variant="destructive" title="Not saved">
            {error}
          </Alert>
        )
      }
      <div class="grid gap-6 @xl:grid-cols-2">
        <slot />
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-border pt-6">
        <slot name="actions" />
      </div>
    </form>
  </Card>
</section>
