---
/**
 * FilterBar — search and filters as a GET form, so the filtered view is a
 * URL: linkable, bookmarkable, and working without JavaScript. Changing a
 * filter goes back to page 1.
 */
import { inputClasses, labelClasses } from "../ui/variants";
import Button from "./Button.astro";

interface Option {
  value: string;
  label: string;
}
interface Select {
  name: string;
  label: string;
  options: Option[];
  /** Label for "no filter". */
  allLabel?: string;
}
interface Props {
  /** Accessible name for the search field, e.g. "Search families". */
  searchLabel: string;
  q: string;
  selects?: Select[];
  values?: Record<string, string>;
  /** Parameters to carry through (e.g. a selected row). */
  keep?: Record<string, string>;
  /** Where "Clear" goes: the page with no filters. */
  clearHref: string;
}
const { searchLabel, q, selects = [], values = {}, keep = {}, clearHref } = Astro.props;
const active = q !== "" || Object.keys(values).length > 0;
---

<form method="get" role="search" class="flex flex-wrap items-end gap-4 rounded-lg border border-border bg-card p-4" data-slot="filter-bar">
  {Object.entries(keep).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <div class="grid min-w-0 grow basis-72 gap-2">
    <label for="filter-q" class={labelClasses}>{searchLabel}</label>
    <input id="filter-q" name="q" type="search" value={q} class={inputClasses} autocomplete="off" />
  </div>
  {
    selects.map((s) => (
      <div class="grid min-w-0 grow basis-48 gap-2">
        <label for={`filter-${s.name}`} class={labelClasses}>
          {s.label}
        </label>
        <select id={`filter-${s.name}`} name={s.name} class={inputClasses}>
          <option value="">{s.allLabel ?? "All"}</option>
          {s.options.map((o) => (
            <option value={o.value} selected={values[s.name] === o.value}>
              {o.label}
            </option>
          ))}
        </select>
      </div>
    ))
  }
  <div class="flex flex-wrap items-center gap-3">
    <Button type="submit" variant="primary">Apply</Button>
    {active && <Button href={clearHref} variant="ghost">Clear</Button>}
  </div>
</form>
